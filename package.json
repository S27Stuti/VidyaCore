{
  "name": "vidyacore-suite",
  "version": "1.0.0",
  "description": "Modern Full-Stack MERN School/College Management & Communication Web Application",
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/src/server.js",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "socket.io": "^4.8.4"
  },
  "keywords": ["mern", "school-management", "socket.io", "tailwind", "ai-campus"],
  "author": "VidyaCore Team",
  "license": "ISC"
}

